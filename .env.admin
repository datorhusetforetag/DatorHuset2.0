# Adminportalen.
#
# Vite läser den här filen när den startas med --mode admin. Variabeln
# är det enda som skiljer de två apparna åt: App.tsx läser den och visar
# antingen butiken eller portalen.
#
# Inga hemligheter här. Filen är med i git med flit, eftersom bygget
# behöver den och värdet inte är känsligt - till skillnad från .env,
# som är ignorerad.
VITE_APP_MODE=admin
